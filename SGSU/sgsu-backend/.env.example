### Example environment variables for local development
# Copy to ".env" (do NOT commit real secrets) or export these in your shell.

# PostgreSQL datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me_secure_password

# Spring Boot port
SERVER_PORT=8081

# Keycloak admin credentials (only for local test environments)
# KC_BOOTSTRAP_ADMIN_USERNAME=admin
# KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Notes:
# - Never commit real credentials. Use a secrets manager for production.
# - This file is an example; copy to ".env" and update values as needed.
